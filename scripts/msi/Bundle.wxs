<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Compositor Windows" Manufacturer="Compositor Windows"
          Version="$(var.Version)" UpgradeCode="CF84B6B3-6B88-4BCA-8704-914E1A59693F"
          IconSourceFile="$(var.Icon)">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="" LogoFile="$(var.Logo)" SuppressOptionsUI="yes" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(var.Msi)" bal:DisplayInternalUICondition="WixBundleAction = 6" />
    </Chain>
  </Bundle>
</Wix>
