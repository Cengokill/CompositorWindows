# Pinned, static HDR codecs. Sources stay in the CMake cache for offline rebuilds
# and are included as corresponding sources by package.ps1.
include(FetchContent)
function(compositor_hdr_dependencies)
  set(BUILD_SHARED_LIBS OFF)
  set(BUILD_TESTING OFF)
  set(IMATH_BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(IMATH_INSTALL OFF CACHE BOOL "" FORCE)
  set(IMATH_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(PYILMBASE_ENABLE OFF CACHE BOOL "" FORCE)
  set(OPENEXR_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
  set(OPENEXR_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(OPENEXR_INSTALL OFF CACHE BOOL "" FORCE)
  set(OPENEXR_TEST_LIBRARIES OFF CACHE BOOL "" FORCE)
  set(OPENEXR_FORCE_INTERNAL_DEFLATE ON CACHE BOOL "" FORCE)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../dependencies.lock.json" lock)
  foreach(name imath openexr libdeflate)
    string(JSON url GET "${lock}" hdr ${name} url)
    string(JSON hash GET "${lock}" hdr ${name} sha256)
    set(archive "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../dependencies/downloads/hdr/${name}.tar.gz")
    if(NOT EXISTS "${archive}")
      file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON STATUS download_status)
      list(GET download_status 0 status_code)
      if(NOT status_code EQUAL 0)
        file(REMOVE "${archive}")
        message(FATAL_ERROR "HDR source download failed: ${download_status}")
      endif()
    endif()
    file(SHA256 "${archive}" actual)
    if(NOT actual STREQUAL hash)
      message(FATAL_ERROR "HDR source checksum mismatch: ${name}")
    endif()
    set(${name}_archive "${archive}")
    set(${name}_hash "${hash}")
  endforeach()
  FetchContent_Declare(Imath URL "${imath_archive}" URL_HASH "SHA256=${imath_hash}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(Imath)
  # First declaration wins; OpenEXR's internal libdeflate fetch uses this pin.
  FetchContent_Declare(deflate URL "${libdeflate_archive}" URL_HASH "SHA256=${libdeflate_hash}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_Declare(OpenEXR URL "${openexr_archive}" URL_HASH "SHA256=${openexr_hash}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(OpenEXR)
endfunction()
compositor_hdr_dependencies()
