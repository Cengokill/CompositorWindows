{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 6
  },
  "configurePresets": [
    {
      "name": "windows-x64-debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/dependencies/qt",
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0",
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x64-release",
      "inherits": "windows-x64-debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "windows-x64-asan",
      "inherits": "windows-x64-release",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "COMPOSITOR_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-asan",
      "configurePreset": "windows-x64-asan",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true,
        "maxPassedTestOutputSize": 65536,
        "maxFailedTestOutputSize": 65536
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "PATH": "${sourceDir}/dependencies/qt/bin;$penv{PATH}",
        "QT_PLUGIN_PATH": "${sourceDir}/dependencies/qt/plugins"
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true,
        "maxPassedTestOutputSize": 65536,
        "maxFailedTestOutputSize": 65536
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "PATH": "${sourceDir}/dependencies/qt/bin;$penv{PATH}",
        "QT_PLUGIN_PATH": "${sourceDir}/dependencies/qt/plugins"
      }
    },
    {
      "name": "windows-x64-asan",
      "inherits": "windows-x64-release",
      "configurePreset": "windows-x64-asan",
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:windows_hook_rtl_allocators=true"
      }
    }
  ]
}
