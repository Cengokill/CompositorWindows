cmake_policy(SET CMP0054 NEW)
foreach(argument IN ITEMS EXECUTABLE CASE SOURCE_ROOT OBSERVED_MANIFEST
    OBSERVED_CPP OBSERVED_OBJECT GRAPHICS_LIBRARY CORE_LIBRARY EVIDENCE_ROOT)
  if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${argument}")
  endif()
endforeach()
foreach(argument IN ITEMS EXECUTABLE OBSERVED_MANIFEST OBSERVED_CPP
    OBSERVED_OBJECT GRAPHICS_LIBRARY CORE_LIBRARY)
  if(NOT EXISTS "${${argument}}")
    message(FATAL_ERROR "Missing build output ${argument}: ${${argument}}")
  endif()
endforeach()

file(READ "${OBSERVED_MANIFEST}" manifest)
string(JSON schema GET "${manifest}" schema)
if(NOT schema STREQUAL "MASK_COMPOSITION_OBSERVER_V1")
  message(FATAL_ERROR "Unknown mask observer manifest schema")
endif()
file(SHA256 "${OBSERVED_CPP}" observed_hash)
string(JSON expected_hash GET "${manifest}" observed_cpp_sha256)
if(NOT observed_hash STREQUAL expected_hash)
  message(FATAL_ERROR "Observed Document.cpp changed; rebuild mask_composition_tests")
endif()
string(JSON count LENGTH "${manifest}" sources)
if(count LESS 1)
  message(FATAL_ERROR "Observer source manifest is empty")
endif()
math(EXPR last "${count}-1")
foreach(index RANGE ${last})
  string(JSON path GET "${manifest}" sources ${index} path)
  string(JSON expected_hash GET "${manifest}" sources ${index} sha256)
  file(SHA256 "${SOURCE_ROOT}/${path}" actual_hash)
  if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Observer input changed: ${path}; rebuild mask_composition_tests")
  endif()
endforeach()

# Keep the established evidence runner's exit-code and predicate checks.
set(OUTPUT_DIRECTORY ON)
include("${SOURCE_ROOT}/tests/run-evidence-case.cmake")
