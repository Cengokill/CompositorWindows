function(launch_recorded_process)
  cmake_parse_arguments(PARSE_ARGV 0 LRP "" "TIMEOUT;STATUS_VAR;STDOUT_VAR;STDERR_VAR" "ARGS")
  if(NOT LRP_TIMEOUT)
    set(LRP_TIMEOUT 60)
  endif()
  set(max_attempts 5)
  set(attempt 0)
  set(status "not-started")
  set(stdout "")
  set(stderr "")
  set(launch_trace "")
  while(attempt LESS max_attempts)
    math(EXPR attempt "${attempt}+1")
    execute_process(COMMAND ${LRP_ARGS}
      RESULT_VARIABLE status
      OUTPUT_VARIABLE stdout
      ERROR_VARIABLE stderr
      TIMEOUT ${LRP_TIMEOUT})
    if(NOT status STREQUAL "operation not permitted")
      break()
    endif()
    set(line "Launch attempt ${attempt}/${max_attempts} failed: operation not permitted\n")
    message("${line}")
    string(APPEND launch_trace "${line}")
    if(NOT stdout STREQUAL "")
      string(APPEND launch_trace "${stdout}")
    endif()
    if(NOT stderr STREQUAL "")
      string(APPEND launch_trace "${stderr}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
  endwhile()
  if(NOT launch_trace STREQUAL "")
    set(stderr "${launch_trace}${stderr}")
  endif()
  set(${LRP_STATUS_VAR} "${status}" PARENT_SCOPE)
  set(${LRP_STDOUT_VAR} "${stdout}" PARENT_SCOPE)
  set(${LRP_STDERR_VAR} "${stderr}" PARENT_SCOPE)
endfunction()
